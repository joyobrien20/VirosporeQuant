)
anova(viro_model)
spore_model2 <- lm(
log10(spores.ml + 1) ~ factor(Infection.time.h) + factor(MOI),
data = opt
)
library(emmeans)
emmeans(spore_model2, pairwise ~ factor(Infection.time.h), adjust = "tukey")
viro_model2 <- lm(
log10(virospores.ml + 1) ~ factor(Infection.time.h),
data = opt
)
anova(viro_model2)
library(emmeans)
pairs(emmeans(viro_model2, "Infection.time.h"), adjust = "tukey")
