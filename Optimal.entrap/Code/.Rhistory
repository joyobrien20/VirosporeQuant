# EE
opt <- opt %>%
mutate(
ee = (virospores.ml / (virospores.ml + spores.ml)) * 100
)
opt_long <- opt %>%
select(Infection.time.h, Rep, spores.ml, virospores.ml, ee) %>%
pivot_longer(
cols = c(spores.ml, virospores.ml),
names_to = "Type",
values_to = "count"
) %>%
mutate(
Type = recode(Type,
spores.ml = "Spores",
virospores.ml = "Virospores")
)
library(tidyverse)
ggplot(opt, aes(x = factor(Time.infection.hr), y = virospores.ml)) +
geom_boxplot(outlier.shape = NA, alpha = 0.4) +
geom_jitter(aes(color = factor(MOI)), width = 0.15, size = 2, alpha = 0.8) +
scale_y_log10() +
labs(
x = "Time of infection (h)",
y = "Virospores per mL",
color = "MOI",
title = "Distribution of virospores over time"
)
